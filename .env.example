DJANGO_SECRET_KEY=replace-with-a-private-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=100.64.0.10,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://100.64.0.10:8000
FRONTPORCH_DEFAULT_PHONE_REGION=US
FRONTPORCH_WEB_BIND_IP=100.64.0.10
FRONTPORCH_WEB_PORT=8000
TZ=America/New_York

POSTGRES_DB=frontporch
POSTGRES_USER=frontporch
POSTGRES_PASSWORD=replace-with-a-private-password
POSTGRES_VOLUME_NAME=frontporch-postgres

ASTERISK_ETC_DIR=./asterisk/etc
ASTERISK_CONF_D_DIR=./asterisk/etc/conf.d
ASTERISK_LOG_DIR=./asterisk/logs
ASTERISK_SPOOL_DIR=./asterisk/spool
# Private custom prompts only. Official Core Sounds are built into the image.
ASTERISK_CUSTOM_SOUNDS_DIR=./asterisk/sounds
# Local/offline prompt settings. Changing any value creates a new cache key.
ASTERISK_TTS_ENGINE_SIGNATURE=piper-tts-1.7.0_en_US-ljspeech-medium-f5a6e9094787_sox-14.4.2+git20190427-3.5
ASTERISK_TTS_VOICE=en_US-ljspeech-medium
ASTERISK_TTS_MODEL_PATH=/opt/frontporch/piper/en_US-ljspeech-medium.onnx
ASTERISK_TTS_LENGTH_SCALE=1.0
ASTERISK_TTS_NOISE_SCALE=0.667
ASTERISK_TTS_NOISE_W_SCALE=0.8
ASTERISK_TTS_RANDOM_SEED=1729
ASTERISK_TTS_VOLUME=1.0
ASTERISK_AUTO_APPLY_CONFIG=true
ASTERISK_AMI_HOST=100.64.0.10
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=frontporch-reload
ASTERISK_AMI_PASSWORD=replace-with-a-private-password
ASTERISK_AMI_TIMEOUT=5

# Use an authorized outbound caller ID for your SIP trunk.
# For VoIP.ms this is normally a 10-digit DID on the account, without +1.
ASTERISK_OUTBOUND_CALLER_ID=2025550199

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Guardian invitations: set real values only in private deployment configuration.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_HOST_USER=replace-with-private-smtp-user
DJANGO_EMAIL_HOST_PASSWORD=replace-with-private-smtp-password
DJANGO_DEFAULT_FROM_EMAIL=FrontPorch <noreply@example.com>

# Canonical portal origin for invitation links behind a reverse proxy.
FRONTPORCH_PUBLIC_URL=https://frontporch.example.com

# Optional public portal; see docs/operations/public-portal.md.
# Leave the existing FRONTPORCH_WEB_BIND_IP on the NAS's Tailscale address.
FRONTPORCH_PUBLIC_HOST=front.porchlab.app
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.local/cloudflare-tunnel-token
